#!/usr/bin/env bash
set -euo pipefail

# Drive an isolated Morgenblau instance and keep the evidence.
# Every subcommand takes the run's slug; evidence lands in .scratch/verify/<date>-<slug>/.
USAGE='usage: verify <command> [args]

  doctor                          check this machine can verify; exit 0 ok, 3 no local PDS (anonymous only), 1 fail
  up <slug> [--fetch-minutes N]   start an isolated instance (own ports, fresh DB, own Vite, own PDS and account); prints its state
                                  --fetch-minutes turns on the global feed refresher (default off)
  login <slug>                    sign the run cookie jar in as the run account and wait for the login sync
  api <slug> <METHOD> <path> [--data JSON] [--out NAME] [--anon]
                                  call the instance; prints the body, status on stderr; --out keeps NAME.json + NAME.status
  inspect <slug> [--out NAME]     JSON snapshot of the run DB (counts, subscriptions, saves, newsletter rows)
  mail <slug> [send-newsletter flags]
                                  send the MIME fixture (or -eml FILE) to the instance SMTP receiver, e.g. -to ADDRESS
  foreign <slug>                  arrange a second reader (placeholder DID) with a newsletter address; prints {did,address}
  browser <slug> <playwright-cli command> [args]
                                  drive a browser session named after the slug; page-level commands only,
                                  a /path expands to the instance URL, files stay in the evidence dir
  down <slug> [--dry-run]         close the browser, stop what up started, drop the DB, the PDS data and the account
  stale [--dry-run]               run down for every run with a dead process or started over STALE_HOURS ago
  status                          list runs and whether their processes are alive

The instance runs the working tree: a Go binary built by up, a Vite dev server on a spare port,
a throwaway PLC and PDS (pds/boot.mjs) holding one .test account, fresh secrets, APP_ENV=local,
FETCH_INTERVAL_MINUTES=0 unless asked, newsletter SMTP on 127.0.0.1 for newsletter.localhost.
It never touches ./data/morgenblau.db, .env or a server the user already runs.'

PLAYWRIGHT_CLI="@playwright/cli@0.1.22"
NEWSLETTER_DOMAIN="newsletter.localhost"
PDS_TOOLS=".agents/skills/verify-morgenblau/pds"
NODE_MAJOR_MIN=22
STALE_HOURS=3

# browser runs without a prompt, so it passes only page-level commands; nothing that runs Node code or touches host files.
BROWSER_COMMANDS=" open close goto go-back go-forward reload
    snapshot find eval screenshot pdf upload
    click dblclick fill type select check uncheck hover drag
    press keydown keyup mousemove mousedown mouseup mousewheel resize
    dialog-accept dialog-dismiss
    tab-list tab-new tab-close tab-select
    console requests request request-headers request-body response-headers response-body
    list "
BROWSER_REFUSED_OPTIONS=" config profile persistent browser cdp endpoint extension "
# playwright-cli's boolean options never take the next argument as a value.
BROWSER_BOOLEAN_OPTIONS=" headed mobile persistent submit boxes clear full-page hires httpOnly secure static global
    with-deps dry-run list force only-shell no-shell cursor annotate kill hide all g help json raw version "

ROOT="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
cd "$ROOT"
VERIFY_ROOT="$ROOT/.scratch/verify"

die() { printf 'verify: %s\n' "$1" >&2; exit "${2:-1}"; }
say() { printf '%s\n' "$1" >&2; }

# The scope is product config, not a secret, so runs take it from the process env or the committed example.
oauth_scope() {
    if [ -n "${BLUESKY_OAUTH_SCOPE-}" ]; then printf '%s' "$BLUESKY_OAUTH_SCOPE"; return; fi
    sed -n 's/^BLUESKY_OAUTH_SCOPE=//p' "$ROOT/.env.example" | tail -1 | sed -e 's/^"\(.*\)"$/\1/'
}

node_major() { node -p 'process.versions.node.split(".")[0]' 2>/dev/null || printf 0; }

pds_tools_installed() {
    local want have
    want="$(jq -r '.dependencies["@atproto/dev-env"]' "$PDS_TOOLS/package.json")"
    have="$(jq -r .version "$PDS_TOOLS/node_modules/@atproto/dev-env/package.json" 2>/dev/null || true)"
    [ "$want" = "$have" ]
}

pds_available() { [ "$(node_major)" -ge "$NODE_MAJOR_MIN" ] && pds_tools_installed; }

port_free() { ! lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

# A port is taken when something listens on it or another live run's state.json claims it before binding it.
free_port() {
    local port="$1" claimed="$2"
    while ! port_free "$port" || grep -qx "$port" <<<"$claimed"; do port=$((port + 1)); done
    printf '%s' "$port"
}

claimed_ports() {
    local file
    for file in "$VERIFY_ROOT"/*/run/state.json; do
        [ -f "$file" ] || continue
        jq -r 'select(.status == "up" or .status == "starting") | .ports[]?' "$file"
    done
}

# Parallel ups choose ports and write the state.json that claims them under this lock, so no two pick the same port.
lock_ports() {
    local lock="$VERIFY_ROOT/.ports.lock" holder i
    mkdir -p "$VERIFY_ROOT"
    for i in $(seq 1 100); do
        if mkdir "$lock" 2>/dev/null; then
            printf '%s' "$$" >"$lock/pid"
            trap unlock_ports EXIT
            return 0
        fi
        holder="$(cat "$lock/pid" 2>/dev/null || true)"
        if [ -n "$holder" ] && ! alive "$holder"; then rm -rf "$lock"; fi
        sleep 0.1
    done
    die "$lock is still held after 10s; remove it if no verify up is running"
}

unlock_ports() {
    rm -rf "$VERIFY_ROOT/.ports.lock"
    trap - EXIT
}

alive() { [ -n "${1-}" ] && [ "$1" != null ] && kill -0 "$1" 2>/dev/null; }

kill_tree() {
    local pid="$1" signal="${2:-TERM}" child
    for child in $(pgrep -P "$pid" 2>/dev/null); do kill_tree "$child" "$signal"; done
    kill -s "$signal" "$pid" 2>/dev/null || true
}

# The PDS must be gone before down deletes its data dir, or a late write recreates it.
stop_tree() {
    local pid="$1" i
    kill_tree "$pid"
    for i in $(seq 1 50); do
        alive "$pid" || return 0
        sleep 0.2
    done
    kill_tree "$pid" KILL
}

run_dir() {
    local slug="$1" match
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slug '$slug' must be lowercase letters, digits and dashes."
    match="$(ls -d "$VERIFY_ROOT"/*-"$slug" 2>/dev/null | sort | tail -1 || true)"
    [ -n "$match" ] && [ -f "$match/run/state.json" ] || die "no run for slug '$slug'; start one with: verify up $slug"
    printf '%s' "$match"
}

state() { jq -r "$2" "$1/run/state.json"; }

set_state() {
    local dir="$1" filter="$2" tmp
    tmp="$(mktemp)"
    jq "$filter" "$dir/run/state.json" >"$tmp" && mv "$tmp" "$dir/run/state.json"
}

doctor() {
    local status=0 tool missing
    ok() { printf '  ok    %s\n' "$1"; }
    bad() { printf '  FAIL  %s\n' "$1"; status=1; }

    for tool in go goose bun jq sqlite3 curl lsof openssl; do
        if command -v "$tool" >/dev/null; then ok "$tool on PATH"; else bad "$tool missing (see README.md Prerequisites)"; fi
    done
    missing="$(jq -r '(.dependencies + .devDependencies) | keys[]' frontend/package.json \
        | while read -r dep; do [ -f "frontend/node_modules/$dep/package.json" ] || printf '%s ' "$dep"; done)"
    if [ -z "$missing" ]; then ok "frontend dependencies installed"; else bad "frontend dependencies missing (${missing% }); run: bun install --cwd ./frontend --frozen-lockfile"; fi
    if git check-ignore -q .scratch/verify; then ok ".scratch/verify is gitignored"; else bad ".scratch/verify is not gitignored"; fi
    if bunx "$PLAYWRIGHT_CLI" --version >/dev/null 2>&1; then ok "playwright-cli ($PLAYWRIGHT_CLI) resolves"; else bad "bunx $PLAYWRIGHT_CLI failed (needs network once)"; fi
    ok "instances force APP_ENV=local, fresh secrets, a fresh DB under .scratch/verify, SMTP on 127.0.0.1 only"
    [ "$status" = 0 ] || { printf 'doctor: FAIL\n'; return 1; }

    local blocked=0
    if [ "$(node_major)" -ge "$NODE_MAJOR_MIN" ]; then ok "node $(node --version) runs the local PDS"; else
        printf '  BLOCKED  node %s or newer is missing; the local PDS needs it\n' "$NODE_MAJOR_MIN"; blocked=1; fi
    if pds_tools_installed; then ok "local PDS tools installed ($PDS_TOOLS)"; else
        printf '  BLOCKED  local PDS tools missing or outdated; run: bun install --cwd %s --frozen-lockfile\n' "$PDS_TOOLS"; blocked=1; fi
    if [ "$blocked" = 0 ]; then
        printf 'doctor: ok\n'
    else
        printf 'doctor: anonymous only (signed-in surfaces are blocked)\n'
        return 3
    fi
}

start_pds() {
    local dir="$1" plc="$2" pds="$3"
    mkdir -p "$dir/run/pds"
    (cd "$PDS_TOOLS" && PDS_DATA_DIR="$dir/run/pds" PDS_PORT="$pds" PLC_PORT="$plc" exec node boot.mjs) >"$dir/pds.log" 2>&1 &
    set_state "$dir" ".pids.pds = $!"
}

wait_for_pds() {
    local dir="$1" url="$2" i
    for i in $(seq 1 120); do
        curl -fsS -o /dev/null "$url/xrpc/com.atproto.server.describeServer" 2>/dev/null && return 0
        alive "$(state "$dir" .pids.pds)" || return 1
        sleep 0.5
    done
    return 1
}

# Each PDS holds one account, so the handle only has to satisfy the PDS: a reserved-word-free prefix and an 18-character first label.
run_handle() {
    local name="verify-${1:0:11}"
    while [[ "$name" == *- ]]; do name="${name%-}"; done
    printf '%s.test' "$name"
}

# The passwords stay in run/account.json (0600) and the server's environment; nothing prints them.
create_account() {
    local dir="$1" url="$2" handle="$3" password created app
    password="$(openssl rand -hex 24)"
    created="$(jq -n --arg handle "$handle" --arg password "$password" '{handle: $handle, email: "verify@example.com", password: $password}' \
        | curl -fsS -X POST -H 'content-type: application/json' --data @- "$url/xrpc/com.atproto.server.createAccount")" || return 1
    app="$(curl -fsS -X POST -H 'content-type: application/json' -H "authorization: Bearer $(jq -r .accessJwt <<<"$created")" \
        --data '{"name":"verify"}' "$url/xrpc/com.atproto.server.createAppPassword")" || return 1
    (umask 077; jq -n --argjson created "$created" --argjson app "$app" --arg password "$password" \
        '{handle: $created.handle, did: $created.did, password: $password, app_password: $app.password}' >"$dir/run/account.json")
    set_state "$dir" ".pds.handle = $(jq '.handle' <<<"$created") | .pds.did = $(jq '.did' <<<"$created")"
}

oauth_private_key() { openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | openssl base64 -A; }

up() {
    local slug="$1" fetch="${2:-0}" dir run http smtp vite plc="" pds="" claimed dev=false pds_url="" plc_url="" handle="" password="" server_pid i
    [[ "$fetch" =~ ^[0-9]+$ ]] || die "--fetch-minutes takes a whole number of minutes"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "slug '$slug' must be lowercase letters, digits and dashes."
    dir="$VERIFY_ROOT/$(date +%F)-$slug"
    run="$dir/run"
    if [ -f "$run/state.json" ] && [[ "$(state "$dir" .status)" =~ ^(up|starting)$ ]]; then
        die "run '$slug' is already up at $(state "$dir" .base_url); run: verify down $slug"
    fi
    mkdir -p "$run"
    pds_available && dev=true

    lock_ports
    claimed="$(claimed_ports)"
    http="$(free_port 8100 "$claimed")"; claimed+=$'\n'"$http"
    smtp="$(free_port 2600 "$claimed")"; claimed+=$'\n'"$smtp"
    vite="$(free_port 5180 "$claimed")"; claimed+=$'\n'"$vite"
    if [ "$dev" = true ]; then
        plc="$(free_port 2700 "$claimed")"; claimed+=$'\n'"$plc"
        pds="$(free_port 2700 "$claimed")"
        plc_url="http://localhost:$plc"; pds_url="http://localhost:$pds"
    fi
    jq -n --arg slug "$slug" --arg dir "$dir" --arg base "http://127.0.0.1:$http" \
        --argjson http "$http" --argjson smtp "$smtp" --argjson vite "$vite" --argjson dev "$dev" \
        --arg plc "$plc" --arg pds "$pds" --arg plc_url "$plc_url" --arg pds_url "$pds_url" \
        --arg domain "$NEWSLETTER_DOMAIN" --arg started "$(date -u +%FT%TZ)" --argjson epoch "$(date +%s)" \
        '{slug:$slug, dir:$dir, status:"starting", base_url:$base, http_port:$http, smtp:("127.0.0.1:"+($smtp|tostring)),
          vite_url:("http://127.0.0.1:"+($vite|tostring)), newsletter_domain:$domain, dev_login:$dev, logged_in:false,
          pds:(if $dev then {url:$pds_url, plc_url:$plc_url} else null end),
          ports:([$http, $smtp, $vite] + ([$plc, $pds] | map(select(. != "") | tonumber))),
          pids:{}, started_at:$started, started_epoch:$epoch}' >"$run/state.json"
    unlock_ports

    [ "$dev" = false ] || start_pds "$dir" "$plc" "$pds"
    (cd frontend && exec ./node_modules/.bin/vite --port "$vite" --strictPort) >"$dir/vite.log" 2>&1 &
    set_state "$dir" ".pids.vite = $!"

    fail() { down_run "$dir" false; die "$1"; }
    goose -dir internal/database/migrations sqlite3 "$run/morgenblau.db" up >"$run/migrate.log" 2>&1 \
        || fail "migrations failed; see $run/migrate.log"
    go build -o "$run/morgenblau" ./cmd/api >"$run/build.log" 2>&1 || fail "go build failed; see $run/build.log"
    if [ "$dev" = true ]; then
        wait_for_pds "$dir" "$pds_url" || fail "the local PDS did not start; see $dir/pds.log"
        create_account "$dir" "$pds_url" "$(run_handle "$slug")" || fail "could not create the run's account on $pds_url"
        handle="$(jq -r .handle "$run/account.json")"
        password="$(jq -r .app_password "$run/account.json")"
    fi

    PORT="$http" DB_PATH="$run/morgenblau.db" APP_ENV=local FETCH_INTERVAL_MINUTES="$fetch" \
        VITE_URL="http://127.0.0.1:$vite" DEV_LOGIN_ENABLED="$dev" \
        ATPROTO_HANDLE="$handle" ATPROTO_PASSWORD="$password" ATPROTO_PDS="$pds_url" PLC_URL="$plc_url" \
        SESSION_COOKIE_KEY="$(openssl rand -base64 32)" SESSION_STORE_KEYS="$(openssl rand -base64 32)" \
        BLUESKY_OAUTH_PRIVATE_KEY="$(oauth_private_key)" BLUESKY_OAUTH_SCOPE="$(oauth_scope)" \
        NEWSLETTER_DOMAIN="$NEWSLETTER_DOMAIN" SMTP_HOSTNAME="$NEWSLETTER_DOMAIN" SMTP_LISTEN_ADDR="127.0.0.1:$smtp" \
        SMTP_TLS_CERT_FILE= SMTP_TLS_KEY_FILE= SMTP_TLS_CERT_B64= SMTP_TLS_KEY_B64= \
        "$run/morgenblau" >"$dir/server.log" 2>&1 &
    server_pid=$!
    set_state "$dir" ".pids.server = $server_pid"

    for i in $(seq 1 60); do
        if curl -fsS "http://127.0.0.1:$http/api/health" 2>/dev/null | grep -q '"up"' \
            && curl -fsS -o /dev/null "http://127.0.0.1:$vite/" 2>/dev/null; then
            set_state "$dir" '.status = "up"'
            jq . "$run/state.json"
            return 0
        fi
        alive "$server_pid" || fail "server exited; see $dir/server.log"
        alive "$(state "$dir" .pids.vite)" || fail "vite exited; see $dir/vite.log"
        sleep 1
    done
    fail "instance not healthy after 60s; see $dir/server.log and $dir/vite.log"
}

call() {
    local dir="$1" method="$2" path="$3" data="${4-}" anon="${5-false}" body_file="$6" args
    args=(-sS -X "$method" -o "$body_file" -w '%{http_code}')
    [ "$anon" = true ] || args+=(-b "$dir/run/cookies.txt" -c "$dir/run/cookies.txt")
    [ -z "$data" ] || args+=(-H 'content-type: application/json' --data "$data")
    curl "${args[@]}" "$(state "$dir" .base_url)$path"
}

wait_for_jobs() {
    local dir="$1" body i count
    body="$(mktemp)"
    for i in $(seq 1 120); do
        call "$dir" GET /api/jobs/active "" false "$body" >/dev/null
        count="$(jq 'if type == "array" then length elif . == null then 0 else 1 end' "$body")"
        [ "$count" = 0 ] && { rm -f "$body"; return 0; }
        sleep 1
    done
    rm -f "$body"
    die "sync jobs still active after 120s; inspect: verify api <slug> GET /api/jobs/active"
}

login() {
    local dir="$1" status body
    [ "$(state "$dir" .dev_login)" = true ] || die "this run has no local PDS account (doctor exit 3); signed-in surfaces are blocked." 3
    body="$(mktemp)"
    status="$(call "$dir" POST /dev/login "" false "$body")"
    [ "$status" = 204 ] || die "POST /dev/login returned $status: $(cat "$body"); see $dir/server.log and $dir/pds.log"
    rm -f "$body"
    wait_for_jobs "$dir"
    set_state "$dir" '.logged_in = true'
    jq '{logged_in, handle: .pds.handle, did: .pds.did}' "$dir/run/state.json"
}

api() {
    local dir="$1" method="$2" path="$3" data="" out="" anon=false body status
    shift 3
    while [ $# -gt 0 ]; do
        case "$1" in
            --data) data="$2"; shift 2 ;;
            --out) out="$2"; shift 2 ;;
            --anon) anon=true; shift ;;
            *) die "unknown api option $1" ;;
        esac
    done
    [[ "$path" == /* ]] || die "path must start with /"
    body="$(mktemp)"
    status="$(call "$dir" "$method" "$path" "$data" "$anon" "$body")"
    if [ -n "$out" ]; then
        cp "$body" "$dir/$out.json"
        printf '%s\n' "$status" >"$dir/$out.status"
    fi
    cat "$body"; printf '\n'
    rm -f "$body"
    say "status: $status"
}

inspect() {
    local dir="$1" out="${2-}" db json
    db="$dir/run/morgenblau.db"
    [ -f "$db" ] || die "run DB is gone (the run is down)"
    q() { local rows; rows="$(sqlite3 -readonly -json "$db" "$1")"; printf '%s' "${rows:-[]}"; }
    json="$(jq -n \
        --argjson counts "$(q "SELECT 'feeds' t, count(*) n FROM feeds UNION ALL SELECT 'feed_entries', count(*) FROM feed_entries UNION ALL SELECT 'user_subscriptions', count(*) FROM user_subscriptions UNION ALL SELECT 'user_saves', count(*) FROM user_saves UNION ALL SELECT 'newsletter_addresses', count(*) FROM newsletter_addresses UNION ALL SELECT 'newsletter_sources', count(*) FROM newsletter_sources UNION ALL SELECT 'newsletter_receipts', count(*) FROM newsletter_receipts UNION ALL SELECT 'newsletter_messages', count(*) FROM newsletter_messages UNION ALL SELECT 'newsletter_saves', count(*) FROM newsletter_saves UNION ALL SELECT 'oauth_sessions', count(*) FROM oauth_sessions")" \
        --argjson subs "$(q 'SELECT did, rkey, feed_url, kind, title, is_primary FROM user_subscriptions ORDER BY created_at')" \
        --argjson saves "$(q 'SELECT did, rkey, item_url, feed_url FROM user_saves ORDER BY created_at')" \
        --argjson addresses "$(q 'SELECT did, local_part FROM newsletter_addresses ORDER BY created_at')" \
        --argjson sources "$(q 'SELECT id, did, title, status, is_primary FROM newsletter_sources ORDER BY created_at')" \
        --argjson receipts "$(q 'SELECT id, did, recipient, attempts, last_error FROM newsletter_receipts ORDER BY created_at')" \
        --argjson messages "$(q 'SELECT id, did, source_id, entry_slug, title, has_blocked_remote_images, remote_images_allowed FROM newsletter_messages ORDER BY received_at')" \
        '{counts: ($counts | map({(.t): .n}) | add), user_subscriptions: $subs, user_saves: $saves,
          newsletter_addresses: $addresses, newsletter_sources: $sources, newsletter_receipts: $receipts, newsletter_messages: $messages}')"
    [ -z "$out" ] || printf '%s\n' "$json" >"$dir/$out.json"
    printf '%s\n' "$json"
}

mail() {
    local dir="$1"
    shift
    [ "$(state "$dir" .status)" = up ] || die "run is down"
    go run ./cmd/send-newsletter -smtp "$(state "$dir" .smtp)" "$@" 2>&1 | tee -a "$dir/mail.log"
}

random_base32() { head -c 1024 /dev/urandom | LC_ALL=C tr -dc 'a-z2-7' | cut -c "1-$1"; }

foreign() {
    local dir="$1" did local_part now
    did="did:plc:$(random_base32 24)"
    local_part="verifyforeign$(random_base32 19)"
    now="$(date -u +%Y-%m-%dT%H:%M:%S.000000000Z)"
    sqlite3 -cmd '.timeout 5000' "$dir/run/morgenblau.db" \
        "INSERT INTO newsletter_addresses (did, local_part, created_at) VALUES ('$did', '$local_part', '$now')"
    set_state "$dir" ".foreign = {did: \"$did\", address: \"$local_part@$NEWSLETTER_DOMAIN\"}"
    state "$dir" .foreign
}

refuse() { printf 'verify browser refused: %s\n' "$1" >&2; exit 2; }

# A file the driver reads or writes must sit in the evidence dir, outside run/ (cookies, DB), also through symlinks.
check_evidence_path() {
    local dir="$1" path="$2" existing rest="" real root
    [ -n "$path" ] || refuse "a file argument needs a path inside the evidence dir."
    case "/$path/" in */../*) refuse "$path climbs with '..'; name a path inside the evidence dir." ;; esac
    [[ "$path" = /* ]] || path="$dir/$path"
    root="$(cd "$dir" && pwd -P)"
    existing="$path"
    while [ ! -e "$existing" ] && [ ! -L "$existing" ]; do
        rest="/$(basename "$existing")$rest"
        existing="$(dirname "$existing")"
    done
    if [ -d "$existing" ]; then
        real="$(cd "$existing" && pwd -P)$rest"
    elif [ -L "$existing" ]; then
        refuse "$2 is a symlink."
    else
        real="$(cd "$(dirname "$existing")" && pwd -P)/$(basename "$existing")$rest"
    fi
    case "$real" in
        "$root"/run|"$root"/run/*) refuse "$2 is inside run/, which holds the session cookie and the DB." ;;
        "$root"/*) ;;
        *) refuse "$2 resolves outside the evidence dir $dir." ;;
    esac
}

check_browser_option() {
    local dir="$1" key="$2" value="$3"
    case "$BROWSER_REFUSED_OPTIONS" in *" $key "*) refuse "--$key points the driver at another browser, profile or config file." ;; esac
    case "$key" in
        filename) check_evidence_path "$dir" "$value" ;;
        s|session) refuse "the session is the run's slug; start another run for a second browser." ;;
    esac
}

check_browser_url() {
    local base="$1" url="$2" unsafe='[[:space:][:cntrl:]\\]'
    [[ ! "$url" =~ $unsafe ]] || refuse "the URL $url holds whitespace, a control character or a backslash."
    case "$url" in
        about:blank|"$base"|"$base"/*) URL="$url" ;;
        //*) refuse "$url is not on this run's instance ($base); pass a /path." ;;
        /*) URL="$base$url" ;;
        *) refuse "$url is not on this run's instance ($base); pass a /path." ;;
    esac
}

# Parses arguments the way playwright-cli's minimist does, so what is checked here is what the driver sees.
guard_browser_args() {
    local dir="$1" base="$2" count i=0 arg next value key literal=0 command position positions=()
    shift 2
    ARGS=("$@"); count=$#
    while [ "$i" -lt "$count" ]; do
        arg="${ARGS[$i]}"
        next="${ARGS[$((i + 1))]-}"
        value=""
        if [ "$literal" = 1 ]; then
            positions+=("$i")
        elif [ "$arg" = "--" ]; then
            literal=1
        elif [[ "$arg" =~ ^--([^=]+)=(.*)$ ]]; then
            check_browser_option "$dir" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
        elif [[ "$arg" =~ ^--no-(.+)$ ]]; then
            check_browser_option "$dir" "${BASH_REMATCH[1]}" false
        elif [[ "$arg" =~ ^--. ]] || [ "$arg" = "-s" ]; then
            key="${arg#--}"
            [ "$arg" != "-s" ] || key=s
            if [ $((i + 1)) -lt "$count" ] && ! [[ "$next" =~ ^--?[^-] ]] && [[ "$BROWSER_BOOLEAN_OPTIONS" != *" $key "* ]]; then
                value="$next"
                i=$((i + 1))
            elif [ "$next" = true ] || [ "$next" = false ]; then
                i=$((i + 1))
            fi
            check_browser_option "$dir" "$key" "$value"
        elif [[ "$arg" =~ ^-s=(.*)$ ]]; then
            check_browser_option "$dir" s "${BASH_REMATCH[1]}"
        elif [[ "$arg" =~ ^-[A-Za-z] ]]; then
            refuse "the short option $arg is not supported; use its long form."
        else
            positions+=("$i")
        fi
        i=$((i + 1))
    done
    [ "${#positions[@]}" -gt 0 ] || return 0
    command="${ARGS[${positions[0]}]}"
    case "$BROWSER_COMMANDS" in
        *[[:space:]]"$command"[[:space:]]*) ;;
        *) refuse "'$command' is not a page-level command (see BROWSER_COMMANDS in bin/verify)." ;;
    esac
    for ((position = 1; position < ${#positions[@]}; position++)); do
        case "$command" in
            open|goto|tab-new)
                check_browser_url "$base" "${ARGS[${positions[$position]}]}"
                ARGS[${positions[$position]}]="$URL" ;;
            upload) check_evidence_path "$dir" "${ARGS[${positions[$position]}]}" ;;
        esac
    done
}

browser() {
    local dir="$1" config var
    shift
    [ $# -gt 0 ] || die "browser needs a playwright-cli command; see: verify browser <slug> --help"
    for config in "$dir/.playwright/cli.config.json" "$HOME/.playwright/cli.config.json"; do
        [ ! -e "$config" ] || refuse "$config would reconfigure the driver; move it away first."
    done
    guard_browser_args "$dir" "$(state "$dir" .base_url)" "$@"
    for var in $(compgen -e); do
        case "$var" in PLAYWRIGHT_*|PWTEST_*|PW_*|NODE_OPTIONS) unset "$var" ;; esac
    done
    (cd "$dir" && bunx "$PLAYWRIGHT_CLI" -s="$(state "$dir" .slug)" ${ARGS[@]+"${ARGS[@]}"})
}

down_run() {
    local dir="$1" dry="$2" pid slug
    slug="$(state "$dir" .slug)"
    if [ "$dry" = true ]; then
        say "would stop server $(state "$dir" .pids.server), vite $(state "$dir" .pids.vite) and PDS $(state "$dir" .pids.pds), close browser session $slug, delete the run DB, PDS data and account"
        return 0
    fi
    (cd "$dir" && bunx "$PLAYWRIGHT_CLI" -s="$slug" close >/dev/null 2>&1) || true
    for pid in "$(state "$dir" .pids.server)" "$(state "$dir" .pids.vite)" "$(state "$dir" .pids.pds)"; do
        if alive "$pid"; then stop_tree "$pid"; fi
    done
    rm -rf "$dir"/run/morgenblau.db* "$dir/run/cookies.txt" "$dir/run/morgenblau" "$dir/run/pds" "$dir/run/account.json"
    set_state "$dir" '.status = "down" | .logged_in = false'
    say "down: $slug; evidence kept in $dir"
}

# Live runs may belong to another agent, so stale takes only runs with a dead process or past STALE_HOURS.
stale_reason() {
    local dir="$1" pid
    for pid in $(jq -r '.pids[]?' "$dir/run/state.json"); do
        alive "$pid" || { printf 'process %s is gone' "$pid"; return 0; }
    done
    if [ $(($(date +%s) - $(state "$dir" '.started_epoch // 0'))) -gt $((STALE_HOURS * 3600)) ]; then
        printf 'started over %s hours ago' "$STALE_HOURS"
        return 0
    fi
    return 1
}

stale() {
    local dry="${1-false}" state_file dir reason
    for state_file in "$VERIFY_ROOT"/*/run/state.json; do
        [ -f "$state_file" ] || continue
        dir="$(dirname "$(dirname "$state_file")")"
        [[ "$(state "$dir" .status)" =~ ^(up|starting)$ ]] || continue
        reason="$(stale_reason "$dir")" || continue
        say "stale: $(state "$dir" .slug) ($reason)"
        down_run "$dir" "$dry"
    done
}

status() {
    local state_file dir
    for state_file in "$VERIFY_ROOT"/*/run/state.json; do
        [ -f "$state_file" ] || continue
        dir="$(dirname "$(dirname "$state_file")")"
        jq -c --arg server "$(alive "$(state "$dir" .pids.server)" && echo yes || echo no)" \
            --arg pds "$(alive "$(state "$dir" .pids.pds)" && echo yes || echo no)" \
            '{slug, status, base_url, logged_in, handle: .pds.handle, server_alive: $server, pds_alive: $pds, dir}' "$state_file"
    done
}

cmd="${1-help}"
[ $# -gt 0 ] && shift
case "$cmd" in
    doctor) doctor ;;
    up) { [ $# -eq 1 ] || { [ $# -eq 3 ] && [ "$2" = --fetch-minutes ]; }; } || die "usage: verify up <slug> [--fetch-minutes N]"; up "$1" "${3-}" ;;
    login) [ $# -eq 1 ] || die "usage: verify login <slug>"; login "$(run_dir "$1")" ;;
    api) [ $# -ge 3 ] || die "usage: verify api <slug> <METHOD> <path> [--data JSON] [--out NAME] [--anon]"; d="$(run_dir "$1")"; shift; api "$d" "$@" ;;
    inspect) [ $# -ge 1 ] || die "usage: verify inspect <slug> [--out NAME]"; d="$(run_dir "$1")"; inspect "$d" "$([ "${2-}" = --out ] && echo "${3-}")" ;;
    mail) [ $# -ge 1 ] || die "usage: verify mail <slug> -to ADDRESS [-eml FILE]"; d="$(run_dir "$1")"; shift; mail "$d" "$@" ;;
    foreign) [ $# -eq 1 ] || die "usage: verify foreign <slug>"; foreign "$(run_dir "$1")" ;;
    browser) [ $# -ge 1 ] || die "usage: verify browser <slug> <command> [args]"; d="$(run_dir "$1")"; shift; browser "$d" "$@" ;;
    down) [ $# -ge 1 ] || die "usage: verify down <slug> [--dry-run]"; down_run "$(run_dir "$1")" "$([ "${2-}" = --dry-run ] && echo true || echo false)" ;;
    stale) stale "$([ "${1-}" = --dry-run ] && echo true || echo false)" ;;
    status) status ;;
    help|-h|--help) printf '%s\n' "$USAGE" ;;
    *) printf '%s\n' "$USAGE" >&2; exit 1 ;;
esac
