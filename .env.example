PORT=8000

APP_ENV=local
APP_URL=

DB_PATH=./data/morgenblau.db

# openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl base64 -A
BLUESKY_OAUTH_PRIVATE_KEY=
BLUESKY_OAUTH_SCOPE="atproto repo:app.skyreader.feed.subscription repo:app.skyreader.feed.saved repo:app.skyreader.social.follow repo:app.skyreader.social.share"
BLUESKY_OAUTH_CLIENT_NAME="Morgenblau"
BLUESKY_OAUTH_CLIENT_URI="${APP_URL}"

# Dev: leave empty. Prod: set BLUESKY_CLIENT_ID=https://<your-host>/oauth-client-metadata.json
# and BLUESKY_REDIRECT=https://<your-host>/oauth/callback
# BLUESKY_CLIENT_ID=
# BLUESKY_REDIRECT=
