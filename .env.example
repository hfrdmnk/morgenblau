PORT=8000

APP_ENV=local

# Fly enables alpha mode. Missing/invalid DIDs then stop startup; false opens admission.
ALPHA_ENABLED=false
ALPHA_ALLOWED_DIDS=

# Optional shortcut for a dedicated development account. Real PDS writes apply.
# Requires APP_ENV=local as well. Prefer an app password; never use a personal account.
DEV_LOGIN_ENABLED=false
ATPROTO_HANDLE=
ATPROTO_PASSWORD=
ATPROTO_PDS=

DB_PATH=./data/morgenblau.db

# How often (minutes) to re-fetch every feed in the shared catalog. 0 disables. Default 30.
FETCH_INTERVAL_MINUTES=30

# Container backups. Required for APP_ENV=production; see DEPLOY.md.
# s3://<private-bucket>/morgenblau?endpoint=t3.storage.dev&region=auto
LITESTREAM_REPLICA_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
LITESTREAM_HEARTBEAT_URL=
# One-time bootstrap only. Remove after verifying the first remote backup.
LITESTREAM_ALLOW_EMPTY_REPLICA=false

# Private inbound newsletters are disabled unless both values are set.
# Docker maps host port 25 to container port 2525.
NEWSLETTER_DOMAIN=
SMTP_HOSTNAME=
SMTP_LISTEN_ADDR=
SMTP_MAX_MESSAGE_BYTES=10485760
SMTP_MAX_CONNECTIONS=8

# App-managed Let's Encrypt STARTTLS (HTTP-01 only). Enabling accepts its terms.
# Public port 80 must route to PORT; SMTP waits for certificate readiness.
SMTP_ACME_ENABLED=false
SMTP_CERT_CONTACT_EMAIL=
SMTP_ACME_STORAGE=/data/certmagic
# APP_ENV=local only: disposable ACME CA directory URL and PEM trust root.
SMTP_ACME_CA=
SMTP_ACME_CA_ROOT=

# Alternative static STARTTLS keypair, only with SMTP_ACME_ENABLED=false.
# Configure files or base64 PEM, never both; must be valid for SMTP_HOSTNAME.
SMTP_TLS_CERT_FILE=
SMTP_TLS_KEY_FILE=
SMTP_TLS_CERT_B64=
SMTP_TLS_KEY_B64=

# openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | openssl base64 -A | pbcopy
BLUESKY_OAUTH_PRIVATE_KEY=
# Standardfeed subscription writes require their own grant. Existing sessions
# without it need a fresh sign-in before writing a standard subscription.
BLUESKY_OAUTH_SCOPE="atproto include:blue.morgen.access repo:site.standard.graph.subscription"
# Shown on the consent screen. client_uri host must match BLUESKY_CLIENT_ID host
# in prod; leave empty for dev loopback.
BLUESKY_OAUTH_CLIENT_NAME="Morgenblau"
BLUESKY_OAUTH_CLIENT_URI=

# Dev: leave empty (loopback client; client_id = http://localhost, callback = http://127.0.0.1:$PORT/oauth/callback).
# Prod: BLUESKY_CLIENT_ID=https://<your-host>/oauth-client-metadata.json
#       BLUESKY_REDIRECT=https://<your-host>/oauth/callback
# BLUESKY_CLIENT_ID=
# BLUESKY_REDIRECT=

# 32 random bytes, base64-encoded. Used to seal the (did, session_id) cookie.
# openssl rand -base64 32
SESSION_COOKIE_KEY=

# AEAD keys for encrypting OAuth session material at rest. Comma-separated
# base64 32-byte keys; the first encrypts, all are tried on decrypt (rotation).
# To rotate: prepend a new key, keep the old one until sessions re-save.
# openssl rand -base64 32
SESSION_STORE_KEYS=
