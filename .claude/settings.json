{
	"permissions": {
		"allow": ["Bash(git status)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(bun run build)"],
		"deny": ["Read(node_modules/)", "Read(.env)", "Bash(rm -rf :*)"],
		"ask": ["Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)"]
	},
	"hooks": {
		"Notification": [
			{
				"matcher": "",
				"hooks": [
					{
						"type": "command",
						"command": "notify-send 'Claude Code' 'Awaiting your input'"
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bun lint"
					},
					{
						"type": "command",
						"command": "bun types"
					},
					{
						"type": "command",
						"command": "bun format:dirty"
					}
				]
			}
		]
	}
}
