{
    "permissions": {
        "allow": [
            "Bash(git status)",
            "Bash(git diff:*)",
            "Bash(git log:*)"
        ],
        "deny": [
            "Read(**/.env)",
            "Edit(**/.env)",
            "Write(**/.env)",
            "Bash(rm -rf :*)"
        ],
        "ask": [
            "Bash(git add:*)",
            "Bash(git commit:*)",
            "Bash(git push:*)"
        ]
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "jq -r '.tool_input.file_path // empty' | { read -r f || exit 0; case \"$f\" in *.go) [ -f \"$f\" ] || exit 0; gofmt -w \"$f\" 1>&2 || exit 2; cd \"$(dirname \"$f\")\" || exit 0; [ \"$(go env GOMOD)\" = \"/dev/null\" ] && exit 0; go vet . 1>&2 || exit 2;; esac; }",
                        "timeout": 60,
                        "statusMessage": "gofmt + go vet"
                    }
                ]
            }
        ],
        "Notification": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "notify-send 'Claude Code' 'Awaiting your input'"
                    }
                ]
            }
        ]
    },
    "enabledPlugins": {
        "atproto-skills@atproto-skills": true
    }
}
