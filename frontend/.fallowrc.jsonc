{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  // Dev-only tool loaded from index.html, which fallow doesn't scan.
  "ignoreDependencies": ["react-grab"],
  "overrides": [
    {
      // shadcn base-nova components ship their full API surface; unwired subcomponents are intentional
      "files": ["src/components/ui/**"],
      "rules": { "unused-exports": "off", "unused-types": "off" }
    }
  ]
}
