---
import '@fontsource-variable/geist';
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
import '@fontsource/reenie-beanie';
import '../styles/global.css';
import AppDigest from '../components/AppDigest.astro';
import Logo from '../components/Logo.astro';
import SignupForm from '../components/SignupForm.astro';

const title = 'Morgenblau: the daily web newspaper. Curated by you.';
const description =
	'Morgenblau gathers your favorite blogs, YouTube channels and newsletters into finite daily digests. So you never miss the content you actually care about. And when you’re done, you’re done.';

const steps = [
	{ title: 'Curate your sources', body: 'Add blogs, newsletters, YouTube channels and more. Morgenblau also makes it easy to import subscriptions from other tools.' },
	{ title: 'Use Morgenblau as your daily web newspaper', body: 'All the content that was published today is presented in one calm list. Morgenblau doesn’t artificially boost or hide posts. It only prioritizes sources that you explicitly marked as important to you.' },
	{ title: 'Go on with your day', body: 'When you reach the end of the list, you’re done. Previous days are still available to read if you want to, but that’s your choice. One that you can explicitly make. Or decide not to. It’s up to you.' },
];

const useCases = [
	{ title: 'Newsletters, out of your inbox', body: 'You get a private email address. Use it to sign up to your favorite newsletters. From now on, they arrive in your curated feed, not in your inbox between bills and work mail.', art: '/images/bg-card-newsletters.webp' },
	{ title: 'Channels without the recommendations', body: 'Don’t miss a video from the channels you follow. And then watch them in a calm interface without any distracting sidebars or recommendations. You can even filter out Shorts.', art: '/images/bg-card-youtube.webp' },
	{ title: 'A quiet place to read', body: 'Morgenblau’s interface is intentionally calm and simple. So the only thing that takes your attention is the content. Set in beautiful typography and, depending on your device, in light or dark mode.', art: '/images/bg-card-reading.webp' },
	{ title: 'Save the gems', body: 'If you want to keep a post for later, simply save it to your personal library. Use tags to organize and find them later.', art: '/images/bg-card-library.webp' },
	{ title: 'Follow (almost) every site', body: 'Even if your favorite blog doesn’t have an RSS feed, Morgenblau can still let you follow it. You shouldn’t have to manually visit websites every day, just because they don’t have a feed. Morgenblau can do that for you.', art: '/images/bg-card-web.webp' },
];

const faq = [
	{ q: 'What is Morgenblau?', a: 'A reader for the web you curate. You follow blogs, newsletters, YouTube channels and websites, and Morgenblau gathers what they publish into one web newspaper per day.' },
	{ q: 'Can I use it today?', a: 'Morgenblau is in an invite-only alpha while I finish the essentials. Subscribe to the newsletter and you’ll hear when it opens up.' },
	{ q: 'Do I need to know what RSS is?', a: 'No. Paste the address of a website or a YouTube channel and Morgenblau works out the rest. For newsletters, you sign up with your Morgenblau address.' },
	{ q: 'What happens to the days I skip?', a: 'Nothing. They don’t pile up and no unread count makes you feel guilty. Every past daily digest stays available if you want to go back.' },
	{ q: 'Which sources does it support?', a: 'Blogs and news sites with RSS or Atom feeds, email newsletters, YouTube channels, Standard.site publications on ATProto, and many sites that have no feed at all.' },
	{ q: 'Is there an app?', a: 'Morgenblau runs in the browser on your phone and computer, and you can install it to your home screen like an app.' },
	{ q: 'Can I take my subscriptions with me?', a: 'Yes. Import and export your feeds as OPML, the format every feed reader understands. Your feed subscriptions also live in your own ATProto account.' },
	{ q: 'Is Morgenblau open source?', a: 'Yes. The code is on <a href="https://github.com/hfrdmnk/morgenblau">GitHub</a>.' },
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map(({ q, a }) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href="https://morgen.blue/" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="me" href="https://mastodon.social/@dominikhofer_me" />
		<meta name="theme-color" content="#f5f5f4" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Morgenblau" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content="https://morgen.blue/" />
		<meta property="og:image" content="https://morgen.blue/og.jpg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="The Morgenblau mark and wordmark over a blue and orange sunrise gradient" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" as="image" href="/images/bg-hero.webp" type="image/webp" />
		<script defer data-domain="morgen.blue" src="https://analytics.linea.studio/js/script.js"></script>
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	</head>
	<body>
		<main>
			<section class="panel hero on-art" style="--art: url(/images/bg-hero.webp)" aria-labelledby="hero-title">
				<header class="hero-top"><a href="/" aria-label="Morgenblau home"><Logo size={36} /></a></header>
				<div class="hero-copy">
					<h1 id="hero-title">The daily web newspaper. Curated by you.</h1>
					<p>{description}</p>
					<button type="button" class="button lg on-color" data-open-signup>Follow along</button>
				</div>
				<div class="app-shot" role="img" aria-label="Today’s newspaper in Morgenblau: a list of posts from blogs the reader follows, each with its source.">
					<AppDigest />
				</div>
			</section>

			<section class="statement" aria-label="The problem">
				<p>It often seems like the authentic web is dead. We get sucked into rabbit holes, algorithms show us content we don’t actually care about and we spend way more time on infinite feeds than we intended to. It doesn’t have to be this way. The content you care about is still out there.</p>
			</section>

			<section class="wrap" aria-labelledby="usual-title">
				<h2 id="usual-title">We just have the wrong tools</h2>
				<div class="three">
					<div><h3>Social feeds</h3><p>An algorithm assembles an infinite feed for you. With one goal: Making you spend as much time as possible on the platform. You are never done. And the posts from creators you actually want to see might not even reach you. The algorithm decides.</p></div>
					<div><h3>Newsletters</h3><p>The best content often gets sent via email. But it might get buried in your inbox or not even reach it (hello spam folder). Newsletters deserve to be read in a calm environment. And your inbox deserves to not get filled with even more unread messages.</p></div>
					<div><h3>Feed readers</h3><p>RSS readers are the best tool we got for taking back control over our feeds. But they still have one problem: They can quickly turn into a chore because they tell you exactly how many posts you haven’t read yet. That shouldn’t be the case.</p></div>
				</div>
			</section>

			<section class="panel how on-art" style="--art: url(/images/bg-how.webp)" aria-labelledby="how-title">
				<div class="wrap">
					<h2 id="how-title" aria-label="A finite feed.">A <s>in</s>finite feed.</h2>
					<ol class="three steps">
						{steps.map((s, i) => <li class="glass"><span class="num">{i + 1}</span><h3>{s.title}</h3><p>{s.body}</p></li>)}
					</ol>
				</div>
			</section>

			<section class="wrap" aria-labelledby="uses-title">
				<h2 id="uses-title">All the content you don’t want to miss. In one feed.</h2>
				<ul class="rail">
					{useCases.map((u) => (
						<li class="card on-art" style={`--art: url(${u.art})`}>
							<div class="card-copy"><h3>{u.title}</h3><p>{u.body}</p></div>
						</li>
					))}
				</ul>
			</section>

			<section class="wrap two" aria-label="For RSS and ATProto people">
				<div>
					<h2>For those of you that still miss Google Reader</h2>
					<p>At its core, Morgenblau is a feed reader. Import your subscriptions from any RSS app with OPML, export them whenever you like, and follow anything that has a feed. Social features are coming, for those that want them.</p>
				</div>
				<div>
					<h2>Your data belongs to you.</h2>
					<p>You sign in with <a href="https://atmosphereaccount.com/">your Atmosphere account</a>, the same one you might use on platforms like Bluesky. Your feed subscriptions and saves live in your own ATProto account as public records, not locked inside Morgenblau. You can use them with other apps, build your own or simply take your data wherever you want to go. Private data is coming soon as well.</p>
				</div>
			</section>

			<section class="wrap two faq" aria-labelledby="faq-title">
				<h2 id="faq-title">Frequently asked questions</h2>
				<div>
					{faq.map((f) => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}
				</div>
			</section>

			<section class="wrap why" aria-labelledby="why-title">
				<div class="prints">
					<figure class="print me">
						<img src="/images/dominik.webp" width="720" height="960" alt="Dominik, wearing sunglasses" loading="lazy" />
						<figcaption>That’s me<svg viewBox="0 0 64 52" aria-hidden="true"><path d="M54 4c-2 18-14 34-44 40M10 44l9-8M10 44l11 4" /></svg></figcaption>
					</figure>
					<figure class="print dog">
						<img src="/images/naida.webp" width="720" height="960" alt="Naida, Dominik’s dog, lying in the sun" loading="lazy" />
						<figcaption>Naida, head of good vibes<svg viewBox="0 0 64 44" aria-hidden="true"><path d="M4 34c16 8 36 4 52-22M56 12l-9 3M56 12l0 10" /></svg></figcaption>
					</figure>
				</div>
				<div class="note">
					<h2 id="why-title">Why I’m creating (not) another RSS reader.</h2>
					<p>Hi, I’m Dominik.</p>
					<p>Developer, Student, Runner and a big fan of the open web. I <a href="https://dominikhofer.me/">write my own blog</a> and love to read others’. Which made me a big RSS aficionado over the years.</p>
					<p>As a digital native, RSS readers always felt like this almost ancient but very calm technology to me. One that I’m still surprised is still around and so widely used.</p>
					<p>Unfortunately, most feed readers also feel a bit ancient at times and not much has changed since Google Reader was shut down. They almost all have the same layout and, my biggest gripe, use a system where posts are treated as read or unread.</p>
					<p>I wanted to change that and <a href="https://dominikhofer.me/5hge1qszrnpanydh/">build my own ideal minimal reader</a>. Along the way, I’m exploring how newer technologies like the <a href="https://atproto.com/">AT Protocol</a> can enable an even better experience for users.</p>
					<p>My vision is that Morgenblau doesn’t just turn into another RSS reader. It should become the app for all those people who feel burnt out from modern-day social media feeds that are noisy, depressing and never-ending.</p>
					<p>The old web, the interesting bloggers, the small authentic creators: they are still out there and creating original content every day. You just have to rediscover them.</p>
					<p>Morgenblau helps you with that.</p>
					<img class="signature" src="/signature.svg" width="98" height="93" alt="Dominik’s signature" loading="lazy" />
				</div>
			</section>

			<section class="panel cta on-art" style="--art: url(/images/bg-footer.webp)" aria-labelledby="cta-title">
				<div class="cta-copy">
					<h2 id="cta-title">I’m building it in public.</h2>
					<p>I write a short weekly newsletter about what I’m building, what’s on my mind and good links from the week. Any updates regarding Morgenblau are announced there first, including when it opens up.</p>
					<SignupForm id="footer" tone="glass" />
					<p class="hint">Very casual, no spam ever. Pinky promise. Unsubscribe at any time.</p>
				</div>
				<footer class="foot">
					<span class="brand"><Logo size={16} /> Morgenblau</span>
					<nav aria-label="Footer">
						<a href="https://app.morgen.blue">Sign in</a>
						<a href="https://github.com/hfrdmnk/morgenblau">Source on GitHub</a>
						<a href="https://dominikhofer.me">Made by Dominik Hofer</a>
					</nav>
				</footer>
			</section>
		</main>

		<dialog class="signup" aria-labelledby="signup-title">
			<div class="sheet">
				<button type="button" class="close" aria-label="Close" data-close-signup>
					<svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
				</button>
				<h2 id="signup-title">Follow along</h2>
				<p>Morgenblau is in an invite-only alpha. Get my weekly newsletter and you’ll hear first when it opens up.</p>
				<SignupForm id="modal" stacked />
				<p class="hint">You’ll join my <a href="https://buttondown.com/dominikhofer">personal newsletter</a>. Very casual, no spam ever. Pinky promise. Unsubscribe at any time.</p>
			</div>
		</dialog>
	</body>
</html>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('dialog.signup')!;
	document.querySelectorAll('[data-open-signup]').forEach((b) =>
		b.addEventListener('click', () => {
			dialog.showModal();
			dialog.querySelector('input')?.focus();
		}),
	);
	dialog.querySelector('[data-close-signup]')!.addEventListener('click', () => dialog.close());
	// The sheet fills the dialog, so a click whose target is the dialog itself landed on the backdrop.
	dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
</script>

<style>
	.panel { position: relative; display: flex; flex-direction: column; margin: var(--panel-gap); border-radius: var(--panel-radius); overflow: hidden; isolation: isolate; color: oklch(0.99 0 0); background: var(--art) center / cover, var(--scrim); }
	.panel::before { content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; }

	h2 { margin: 0 0 32px; font: 500 clamp(var(--step-3), 3vw, var(--step-4))/1.15 var(--sans); letter-spacing: -0.03em; }
	h3 { margin: 0 0 8px; font: 600 17px/1.3 var(--sans); }
	p { margin: 0 0 1.5em; font: 400 17px/1.6 var(--sans); color: var(--muted-foreground); }
	.on-art p { color: oklch(1 0 0 / 0.82); }

	/* Hero: centred mark, headline and button; the app rises out of the panel's bottom edge. */
	.hero { align-items: center; min-height: calc(100svh - 2 * var(--panel-gap)); text-align: center; }
	.hero::before { background: linear-gradient(to bottom, oklch(0.2 0.06 250 / 0.5), oklch(0.2 0.06 250 / 0.36) 35%, oklch(0.2 0.06 250 / 0.08) 62%, oklch(0.2 0.06 250 / 0)); }
	.hero-top { padding-top: clamp(28px, 5vh, 48px); }
	.hero-top a { display: grid; place-items: center; width: 44px; height: 44px; color: oklch(0.99 0 0); }
	.hero-copy { display: flex; flex-direction: column; align-items: center; max-width: 760px; padding: clamp(32px, 7vh, 80px) 24px clamp(36px, 6vh, 64px); }
	h1 { margin: 0 0 20px; font: 500 clamp(var(--step-4), 4.4vw, var(--step-6))/1.05 var(--sans); letter-spacing: -0.04em; }
	.hero-copy p { max-width: 46ch; margin-bottom: 32px; font-size: clamp(17px, 1.6vw, var(--step-1)); line-height: 1.45; color: oklch(1 0 0 / 0.9); }
	.app-shot { width: min(1080px, 90%); height: clamp(260px, 44vh, 520px); margin-top: auto; overflow: hidden; container-type: inline-size; border-radius: 12px 12px 0 0; background: var(--background);
		box-shadow: 0 0 0 1px oklch(1 0 0 / 0.25), 0 2px 6px oklch(0.2 0.06 250 / 0.12), 0 24px 64px oklch(0.2 0.06 250 / 0.35); }

	.statement { max-width: 900px; margin: 0 auto; padding: 220px clamp(20px, 5vw, 64px) 80px; }
	.statement p { margin: 0; font: 400 clamp(var(--step-2), 2.8vw, var(--step-4))/1.35 var(--serif); letter-spacing: -0.01em; color: var(--foreground); }

	.wrap { max-width: 1160px; margin: 0 auto; padding: 140px clamp(20px, 5vw, 64px) 0; }
	.wrap > h2 { margin-bottom: 64px; }
	.three { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(40px, 5vw, 72px); margin: 0; padding: 0; list-style: none; }
	.three h3 { margin-bottom: 14px; font-size: var(--step-1); font-weight: 500; letter-spacing: -0.01em; }
	.three p { margin: 0; }

	.how { justify-content: center; min-height: calc(100svh - 2 * var(--panel-gap)); margin-top: 140px; }
	.how::before { background: oklch(0.18 0.04 30 / 0.34); }
	.how .wrap { width: 100%; padding-block: 80px; }
	.steps { gap: 16px; }
	.steps li { display: flex; flex-direction: column; min-height: clamp(300px, 44vh, 420px); }
	.steps h3 { margin-top: auto; }
	.glass { padding: 28px; border-radius: var(--radius-xl); background: oklch(0.18 0.03 30 / 0.22); -webkit-backdrop-filter: blur(20px) saturate(180%); backdrop-filter: blur(20px) saturate(180%); box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.18); }
	.num { display: block; margin-bottom: 32px; font: 500 var(--step-3)/1 var(--sans); font-variant-numeric: tabular-nums; color: oklch(1 0 0 / 0.7); }
	.glass p { font-size: 15px; }

	.rail { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16px; margin: 0; padding: 0; list-style: none; }
	.card { display: flex; grid-column: span 2; align-items: flex-end; min-height: 440px; border-radius: var(--radius-xl); overflow: hidden; background: var(--art) center / cover; }
	.card:nth-child(-n + 2) { grid-column: span 3; }
	.card-copy { width: 100%; padding: 72px 24px 24px; color: oklch(0.99 0 0); background: linear-gradient(to top, oklch(0.15 0.02 260 / 0.62), oklch(0.15 0.02 260 / 0.5) 45%, oklch(0.15 0.02 260 / 0)); }
	.card-copy p { max-width: 46ch; margin: 0; font-size: 15px; line-height: 1.55; }

	.two { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
	.two h2 { font-size: clamp(var(--step-2), 2.2vw, var(--step-3)); margin-bottom: 20px; }
	/* Each column spans both parent rows, so headings of different line counts end on the same line. */
	.two > div:has(> h2) { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 0; }
	.two > div > h2 { align-self: end; }
	.faq details { padding: 18px 0; box-shadow: 0 1px 0 var(--line); }
	.faq details:first-child { padding-top: 0; }
	.faq summary { display: flex; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none; font: 500 17px/1.4 var(--sans); }
	.faq summary::-webkit-details-marker { display: none; }
	.faq summary::after { content: '+'; color: var(--subtle-foreground); }
	.faq details[open] summary::after { content: '−'; }
	.faq details p { margin: 10px 0 0; }

	/* Why: two taped prints with handwritten captions beside them. */
	.why { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 72px; align-items: start; padding-bottom: 140px; }
	.prints { position: sticky; top: 112px; aspect-ratio: 1 / 1.14; }
	.print { position: absolute; margin: 0; padding: 5px; border-radius: 2px; background: oklch(0.993 0.003 85);
		box-shadow: 0 0 0 1px oklch(0.216 0.006 56 / 0.06), 0 1px 2px oklch(0.216 0.006 56 / 0.1), 0 10px 28px -6px oklch(0.216 0.006 56 / 0.22); }
	.print img { aspect-ratio: 3 / 4; width: 100%; object-fit: cover; border-radius: 1px; }
	/* Tape: a translucent strip with torn ends across the top edge. */
	.print::before { content: ''; position: absolute; top: -13px; left: 50%; width: 32%; height: 24px; pointer-events: none;
		background: oklch(0.95 0.02 85 / 0.62); -webkit-backdrop-filter: blur(1px) saturate(120%); backdrop-filter: blur(1px) saturate(120%);
		box-shadow: inset 0 0 0 1px oklch(1 0 0 / 0.25);
		clip-path: polygon(0 4%, 4% 18%, 1% 34%, 5% 50%, 1% 68%, 4% 84%, 0 100%, 100% 96%, 97% 80%, 100% 64%, 96% 48%, 100% 30%, 97% 14%, 100% 0); }
	.me { top: 3%; left: 1%; width: 60%; z-index: 1; transform: rotate(-2.5deg); }
	.me::before { transform: translateX(-50%) rotate(-3deg); }
	.dog { bottom: 1%; right: 1%; width: 47%; z-index: 2; transform: rotate(3deg); }
	.dog::before { transform: translateX(-50%) rotate(4deg); }
	/* Captions are written on the page beside each print, counter-rotated so they read level. */
	.print figcaption { position: absolute; display: flex; gap: 6px; font: 400 clamp(25px, 2.6vw, 30px)/1.15 var(--hand); color: oklch(from var(--foreground) l c h / 0.85); text-wrap: balance; }
	.print svg { flex: none; width: 44px; height: auto; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.8; }
	.me figcaption { top: 6%; left: calc(100% + 18px); width: 58%; flex-direction: column; transform: rotate(2.5deg); }
	.dog figcaption { bottom: 8%; right: calc(100% + 8px); width: 100%; align-items: flex-end; justify-content: flex-end; gap: 2px; text-align: right; transform: rotate(-3deg); }
	.dog svg { margin-bottom: 0.6em; }
	.note p { color: var(--foreground); font: 400 19px/1.65 var(--serif); }
	.signature { width: 88px; height: auto; }

	.cta { min-height: calc(100svh - 2 * var(--panel-gap)); padding: 0 clamp(20px, 5vw, 64px); }
	.cta::before { background: linear-gradient(to top, oklch(0.15 0.03 290 / 0.5), oklch(0.15 0.03 290 / 0.2) 50%, oklch(0.15 0.03 290 / 0)); }
	.cta-copy { max-width: 620px; margin-top: auto; padding-bottom: 64px; }
	.cta h2 { font-size: clamp(var(--step-4), 4.4vw, var(--step-6)); line-height: 1.05; letter-spacing: -0.04em; }
	.hint { margin: 14px 0 0; font-size: 13px; }
	.on-art .hint { color: oklch(1 0 0 / 0.7); }
	.foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding: 24px 0 32px; box-shadow: 0 -1px 0 oklch(1 0 0 / 0.16); font: 400 13px var(--sans); color: oklch(1 0 0 / 0.75); }
	.brand { display: inline-flex; align-items: baseline; gap: 8px; font-weight: 500; color: oklch(0.99 0 0); }
	/* An svg's baseline is its bottom edge; dropping it by the notch height (20 of the mark's 144 units) puts the horizon on the text baseline. */
	.brand :global(svg) { translate: 0 calc(20 / 144 * 100%); }
	.foot nav { display: flex; flex-wrap: wrap; gap: 20px; }
	.foot a { text-decoration: none; }
	@media (hover: hover) and (pointer: fine) { .foot a:hover { color: oklch(0.99 0 0); } }

	/* Matches DialogPopup and DialogBackdrop in the app. */
	.signup { width: min(420px, calc(100% - 2rem)); padding: 0; border: 0; border-radius: var(--radius-xl); color: var(--foreground); background: var(--popover); box-shadow: var(--popover-shadow); }
	.signup::backdrop { background: oklch(from var(--background) l c h / 0.4); -webkit-backdrop-filter: blur(4px) saturate(180%); backdrop-filter: blur(4px) saturate(180%); }
